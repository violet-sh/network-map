{
	"name": "network-map",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"start": "bun ./build",
		"db:push": "drizzle-kit push",
		"db:gen": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:drop": "drizzle-kit drop",
		"db:start": "podman-compose up -d",
		"db:stop": "podman-compose down"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@maptiler/client": "^3.1.0",
		"@orpc/client": "2.0.0-beta.45",
		"@orpc/server": "2.0.0-beta.45",
		"@orpc/tanstack-query": "2.0.0-beta.45",
		"@paralleldrive/cuid2": "^3.3.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@tanstack/svelte-query": "^6.3.5",
		"@tanstack/svelte-query-devtools": "^6.3.5",
		"arctic": "^3.7.0",
		"drizzle-orm": "^0.45.4",
		"drizzle-postgis": "github:gtgaitoKu/drizzle-postgis",
		"maplibre-gl": "^6.15.0",
		"normalize.css": "^8.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.4",
		"@types/geojson": "^7946.0.16",
		"@types/maplibre-gl": "^1.14.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.106.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
